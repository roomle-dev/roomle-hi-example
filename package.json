{
  "name": "roomle-hi-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HI example: the standalone HI presets page with the planning assistant of the roomle-ui embedding-lib",
  "workspaces": [
    "minimal-hi-example",
    "hi-sc-example",
    "minifabric-example",
    "shared"
  ],
  "scripts": {
    "start": "node minimal-hi-example/start.mjs",
    "dev": "node minimal-hi-example/start.mjs --dev",
    "start:sc": "npm run dev --workspace hi-sc-example",
    "start:minifabric": "npm run dev --workspace minifabric-example",
    "dev:proxy": "dotenv -e .env.local -- npx functions-framework --target=proxy_request --source ./minifabric-example/proxy-server/index",
    "deploy:proxy": "gcloud functions deploy proxy_request --runtime nodejs20 --trigger-http --project rml-showcases --region europe-west3 --allow-unauthenticated --source ./minifabric-example/proxy-server --entry-point proxy_request",
    "test": "npm test --workspaces",
    "plan:mistral": "npm start mistral:mistral-large-latest $MISTRAL_API_KEY",
    "plan:gpt5": "npm start azure:gpt-5-mini $AZURE_GPT_KEY -- --reasoning-effort high",
    "plan:gpt5.4": "npm start azure:gpt-5.4-mini $AZURE_GPT_KEY -- --reasoning-effort high",
    "plan:gpt6": "npm start azure:gpt-6-astra $AZURE_GPT_KEY -- --cache-breakpoint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "3.4.5",
    "dotenv-cli": "8.0.0",
    "node-fetch": "3.3.2",
    "oxlint": "1.86.0",
    "prettier": "3.8.3"
  }
}
