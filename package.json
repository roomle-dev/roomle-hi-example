{
  "name": "roomle-hi-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HI example projects including minimal standalone example and MCP server PoCs",
  "workspaces": [
    "hi-mcp",
    "hi-mcp/hi-mcp-server",
    "hi-mcp/hi-mcp-chat",
    "hi-mcp/cf",
    "minimal-hi-example"
  ],
  "scripts": {
    "start": "npm start --workspace minimal-hi-example",
    "mcp-server": "npm start --workspace hi-mcp-server",
    "dev": "npm run dev --workspace minimal-hi-example",
    "start:cf": "npm run start:cf --workspace minimal-hi-example",
    "plan:mistral": "npm start mistral $MISTRAL_API_KEY",
    "plan:gpt5": "npm start gpt-5-mini $AZURE_GPT_KEY",
    "plan:gpt5.4": "npm start gpt-5.4-mini $AZURE_GPT_KEY",
    "plan:gpt6": "npm start gpt-6-astra $AZURE_GPT_KEY",
    "deploy:cf": "cd hi-mcp/cf && npx wrangler deploy",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
