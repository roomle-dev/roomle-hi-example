{
  "name": "roomle-hi-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HI example: the standalone HI presets page with the planning assistant of the roomle-ui embedding-lib",
  "workspaces": [
    "minimal-hi-example"
  ],
  "scripts": {
    "start": "node minimal-hi-example/start.mjs",
    "dev": "node minimal-hi-example/start.mjs --dev",
    "test": "npm test --workspace minimal-hi-example",
    "plan:mistral": "npm start mistral $MISTRAL_API_KEY",
    "plan:gpt5": "npm start gpt-5-mini $AZURE_GPT_KEY",
    "plan:gpt5.4": "npm start gpt-5.4-mini $AZURE_GPT_KEY",
    "plan:gpt6": "npm start gpt-6-astra $AZURE_GPT_KEY",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "oxlint": "1.86.0",
    "prettier": "3.8.3"
  }
}
